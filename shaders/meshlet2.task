#version 460 core
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_ballot: require
#extension GL_ARB_shader_draw_parameters: require
#extension GL_GOOGLE_include_directive : enable

#include "meshlet2_common.glsl"
#include "meshlet2_payload.glsl"
#include "frustum_cull2.glsl"

taskPayloadSharedEXT TaskPayload task_payload;

bool cluster_cull(vec3 center, float radius, vec3 cone_axis, float cone_cutoff, vec3 camera_position) {
    if (cone_cutoff >= 1.0) return false; // meshopt signals -1.0 is uncullable; use >= 1.0 as safe upper guard too
    if (cone_cutoff < -0.999) return false; // can't cone-cull this meshlet
    return dot(center - camera_position, cone_axis) > cone_cutoff * length(center - camera_position) + radius;
}

// pulls id 0 from layout(constant_id = 0) which happens to be SUBGROUP_SIZE
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
void main() {
    uint wg = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x; // 2D dispatch, because I'm hitting 65535 limit quickly with meshlet-instance-count dispatches
    uint mi = wg * gl_WorkGroupSize.x + gl_LocalInvocationID.x;

    bool valid = mi < push_constants.visible_meshlet_instances_count.count;
    bool accept = false;

    if (valid) {
        MeshletInstance meshlet_instance = push_constants.visible_meshlet_instances.items[mi];
        Meshlet meshlet = push_constants.meshlets.items[meshlet_instance.meshlet_index];
        mat4 transform = push_constants.mesh_instances.items[meshlet_instance.mesh_instance_index].transform;
        vec4 pos_world = compute_pos_world(transform, meshlet.bounding_sphere_center);
        float radius_world = compute_radius_world(transform, meshlet.bounding_sphere_radius);
        vec3 cone_axis_world = normalize(transpose(inverse(mat3(transform))) * meshlet.cone_axis);

        vec3 camera_pos = push_constants.cull_camera.position.xyz;

        accept = !cluster_cull(pos_world.xyz, radius_world, cone_axis_world, meshlet.cone_cutoff, camera_pos);
        if (accept) {
            mat4 projview = push_constants.cull_camera.projview;
            accept = accept && !frustum_cull(projview, pos_world.xyz, radius_world);
        }
    }

    uvec4 ballot = subgroupBallot(accept);
    uint slot = subgroupBallotExclusiveBitCount(ballot);
    if (accept) {
        MeshletInstance meshlet_instance = push_constants.visible_meshlet_instances.items[mi];
        task_payload.meshlet_instances[slot] = meshlet_instance;
    }
    uint count = subgroupBallotBitCount(ballot);

    EmitMeshTasksEXT(count, 1, 1);
}
