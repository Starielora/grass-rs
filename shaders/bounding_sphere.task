#version 460 core
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_ballot: require
#extension GL_ARB_shader_draw_parameters: require
#extension GL_GOOGLE_include_directive : enable

#include "bounding_sphere_common.glsl"

Sphere world_sphere(mat4 transform, vec3 center, float radius) {
    Sphere s;
    s.center = (transform * vec4(center, 1.0)).xyz;
    s.radius = radius * length(transform[0].xyz);
    return s;
}

Sphere get_mesh_instance_bounding_sphere(uint mesh_instance_index) {
    MeshInstance mesh_instance = push_constants.mesh_instances.items[mesh_instance_index];
    Mesh mesh = push_constants.meshes.items[mesh_instance.mesh_index];

    return world_sphere(mesh_instance.transform, mesh.bounding_sphere_center, mesh.bounding_sphere_radius);
}

Sphere get_meshlet_instance_bounding_sphere(MeshletInstance meshlet_instance) {
    Meshlet meshlet = push_constants.meshlets.items[meshlet_instance.meshlet_index];
    MeshInstance mesh_instance = push_constants.mesh_instances.items[meshlet_instance.mesh_instance_index];

    return world_sphere(mesh_instance.transform, meshlet.bounding_sphere_center, meshlet.bounding_sphere_radius);
}

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
taskPayloadSharedEXT TaskPayload payload;

void main() {
    uint wg = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint mi = wg * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    bool valid = false;

    #if MESHLET_BOUNDING_SPHERE
        valid = mi < push_constants.visible_meshlet_instances_count.count;
    #else
        valid = mi < push_constants.mesh_instances_count;
    #endif


    bool accept = valid;

    uvec4 ballot = subgroupBallot(accept);
    uint slot = subgroupBallotExclusiveBitCount(ballot);
    if (accept) {
        Sphere s;
        #if MESHLET_BOUNDING_SPHERE
            MeshletInstance meshlet_instance = push_constants.visible_meshlet_instances.items[mi];
            s = get_meshlet_instance_bounding_sphere(meshlet_instance);
        #else
            s = get_mesh_instance_bounding_sphere(mi);
        #endif
        payload.spheres[slot] = s;
    }
    uint count = subgroupBallotBitCount(ballot);

    EmitMeshTasksEXT(count, 1, 1);
}
