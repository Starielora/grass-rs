#version 460 core
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_ballot: require
#extension GL_ARB_shader_draw_parameters: require
#extension GL_GOOGLE_include_directive : enable

#include "meshlet2_common.glsl"

struct Sphere {
    vec3 center;
    float radius;
};

struct TaskPayload2 {
    Sphere spheres[64];
};

taskPayloadSharedEXT TaskPayload2 payload;

Sphere get_mesh_instance_bounding_sphere(uint mesh_instance_index) {
    MeshInstance mesh_instance = push_constants.mesh_instances.items[mesh_instance_index];
    Mesh mesh = push_constants.meshes.items[mesh_instance.mesh_index];

    Sphere s;
    s.center = (mesh_instance.transform * vec4(mesh.bounding_sphere_center, 1.0)).xyz;
    s.radius = mesh.bounding_sphere_radius * length(mesh_instance.transform[0].xyz);

    return s;
}

Sphere get_meshlet_instance_bounding_sphere(uint meshlet_instance_index) {
    MeshletInstance meshlet_instance = push_constants.meshlet_instances.items[meshlet_instance_index];
    Meshlet meshlet = push_constants.meshlets.items[meshlet_instance.meshlet_index];
    MeshInstance mesh_instance = push_constants.mesh_instances.items[meshlet_instance.mesh_instance_index];

    Sphere s;
    s.center = (mesh_instance.transform * vec4(meshlet.bounding_sphere_center, 1.0)).xyz;
    s.radius = meshlet.bounding_sphere_radius * length(mesh_instance.transform[0].xyz);

    return s;
}

// TODO would define be better?
layout(constant_id = 1) const bool MESH_BOUNDING_SPHERE = false;

// pulls id 0 from layout(constant_id = 0) which happens to be SUBGROUP_SIZE
// TODO actually pull it from specialization constant
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
void main() {
    uint wg = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x; // 2D dispatch, because I'm hitting 65535 limit quickly with meshlet-instance-count dispatches
    uint mi = wg * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    bool valid = false;

    if (MESH_BOUNDING_SPHERE) {
        valid = mi < push_constants.mesh_instances_count;
    } else {
        valid = mi < push_constants.meshlet_instances_count;
    }

    bool accept = valid;

    uvec4 ballot = subgroupBallot(accept);
    uint slot = subgroupBallotExclusiveBitCount(ballot); // compact index for survivors
    if (accept) {
        Sphere s;
        if (MESH_BOUNDING_SPHERE) {
            s = get_mesh_instance_bounding_sphere(mi);
        } else {
            s = get_meshlet_instance_bounding_sphere(mi);
        }
        payload.spheres[slot] = s;
    }
    uint count = subgroupBallotBitCount(ballot); // uniform across the subgroup

    EmitMeshTasksEXT(count, 1, 1);
}
