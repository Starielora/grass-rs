#version 460 core
#extension GL_GOOGLE_include_directive : enable

#include "camera_data.glsl"
#include "geometry.glsl"
#include "frustum_cull2.glsl"

layout(push_constant) uniform constants
{
    CameraDataBuf view_camera;
    MeshesBuf meshes;
    MeshInstanceBuf mesh_instances;
    VisibleMeshletInstancesBuf visible_meshlet_instances;
    VisibleMeshletInstancesCountBuf visible_meshlet_instances_count;
    uint mesh_instances_count;
} push_constants;

bool frustum_cull(mat4 projview, vec3 bounding_sphere_center, float bounding_sphere_radius);

layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
void main()
{
    uint mi = gl_GlobalInvocationID.x;

    if (mi >= push_constants.mesh_instances_count)
        return;

    MeshInstance mesh_instance = push_constants.mesh_instances.items[mi];
    Mesh mesh = push_constants.meshes.items[mesh_instance.mesh_index];

    vec4 pos_world = compute_pos_world(mesh_instance.transform, mesh.bounding_sphere_center);
    float radius_world = compute_radius_world(mesh_instance.transform, mesh.bounding_sphere_radius);

    // TODO scale radius with mesh scale
    if (frustum_cull(push_constants.view_camera.projview, pos_world.xyz, radius_world)) {
        return;
    }

    float dist_to_camera = length(pos_world - push_constants.view_camera.position);

    uint lod = uint(clamp(dist_to_camera, 0.0, 50.0f) / (50.0f/float(mesh.lod_count)));

    // uint lod = uint(clamp(dist_to_camera, 0.0, float(mesh.lod_count - 1)));
    MeshLod mesh_lod = mesh.lod[lod];

    uint meshlets_offset = mesh_lod.meshlets_offset;
    uint slots_start = atomicAdd(push_constants.visible_meshlet_instances_count.count, mesh_lod.meshlets_count);
    for (uint i = 0; i < mesh_lod.meshlets_count; ++i) {
        uint slot = slots_start + i;
        MeshletInstance instance;
        instance.lod_index = lod;
        instance.mesh_instance_index = mi;
        instance.meshlet_index = meshlets_offset + i;
        push_constants.visible_meshlet_instances.items[slot] = instance;
    }

}
